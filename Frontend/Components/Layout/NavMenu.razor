@using Microsoft.AspNetCore.Components.Authorization
@inject Frontend.Services.AuthService AuthService
@inject Frontend.Services.ApiService ApiService
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Nimatic</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <!-- Visible to any authenticated user -->
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/dashboard">Dashboard</NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/settings">Settings</NavLink>
                </div>

                <div class="nav-item px-3">
                    <button class="btn btn-outline-danger w-100" @onclick="Logout">Logout</button>
                </div>
            </Authorized>
        </AuthorizeView>

        <!-- Admin only link -->
        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin">Admin</NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <!-- Dealer and Admin link -->
        <AuthorizeView Roles="Dealer,Admin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/dealer">Dealer</NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <!-- Visible to not authenticated users -->
        <AuthorizeView>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/login">Login</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    private bool initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            return;

        if (initialized)
            return;

        initialized = true;

        var token = await AuthService.GetTokenAsync();
        if (!string.IsNullOrWhiteSpace(token))
        {
            ApiService.SetToken(token.Trim('"'));
            // If you use a custom AuthenticationStateProvider, notify it here if needed.
        }

        StateHasChanged();
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}