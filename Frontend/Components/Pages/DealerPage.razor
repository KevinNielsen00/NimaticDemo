@page "/dealer"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Frontend.Models
@inject Frontend.Services.ApiService Api
@inject Frontend.Services.AuthService AuthService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<h3>Dealer panel</h3>

@if (loading)
{
    <p>Loading...</p>
}
else if (!isAuthorized)
{
    <p>Not authorized. Redirecting to login...</p>
}
else
{
    <section>
        <h4>Create Customer</h4>
        <input @bind="customerName" placeholder="Customer name" />
        <button class="btn btn-primary" @onclick="CreateCustomer" disabled="@isProcessingCustomer">Create Customer</button>
        <div>@msg</div>
    </section>

    <section>
        <h4>Create Customer Account</h4>
        <select @bind="selectedCustomerIdForAccount">
            <option value="">-- choose customer --</option>
            @foreach (var c in customers)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>

        <input @bind="accName" placeholder="Name" />
        <input @bind="accEmail" placeholder="Email" />
        <input @bind="accTempPassword" placeholder="Temp password" />

        <label>Role</label>
        <InputSelect @bind-Value="accRole" class="form-select" style="width:200px;">
            @foreach (AccountRole r in Enum.GetValues(typeof(AccountRole)))
            {
                <option value="@r">@r.ToString()</option>
            }
        </InputSelect>

        <button class="btn btn-primary" @onclick="CreateAccount" disabled="@isProcessingAccount">Create Account</button>
        <div>@accMsg</div>
    </section>

    <section>
        <h4>Assign Unit to Account</h4>
        <select @bind="assignAccountId">
            <option value="">-- choose account --</option>
            @foreach (var a in accounts)
            {
                <option value="@a.Id">@a.Email (@a.Name)</option>
            }
        </select>
        <input @bind="assignMac" placeholder="MAC address" />
        <input @bind="assignUnitName" placeholder="Unit name" />
        <input @bind="assignLocation" placeholder="Location" />
        <button class="btn btn-primary" @onclick="AssignUnit">Assign Unit</button>
        <div>@assignMsg</div>
    </section>
}

@code {
    bool loading = true;
    bool isAuthorized = false;
    bool checkedLoginState;
    bool isProcessingCustomer = false;
    bool isProcessingAccount = false;

    List<CustomerDto> customers = new();
    List<AccountDto> accounts = new();

    string customerName = "";
    string msg = "";

    string accName = "";
    string accEmail = "";
    string accTempPassword = "";
    AccountRole accRole = AccountRole.Customer;
    Guid? selectedCustomerIdForAccount;
    string accMsg = "";

    Guid? assignAccountId = null;
    string assignMac = "";
    string assignUnitName = "";
    string assignLocation = "";
    string assignMsg = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || checkedLoginState)
            return;

        checkedLoginState = true;

        loading = true;
        StateHasChanged();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (!user.IsInRole("Dealer"))
        {
            Nav.NavigateTo("/dashboard");
            return;
        }

        isAuthorized = true;

        var token = await AuthService.GetTokenAsync();
        Api.SetToken(token);

        try
        {
            customers = await Api.GetCustomersAsync(asDealer: true);
            accounts = await Api.GetAccountsAsync(asDealer: true);
        }
        catch (HttpRequestException ex)
        {
            if (ex.Message.Contains("401"))
            {
                await AuthService.LogoutAsync();
                Nav.NavigateTo("/login");
                return;
            }
            msg = ex.Message;
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    async Task CreateCustomer()
    {
        isProcessingCustomer = true;
        msg = "";
        try
        {
            var dto = new CreateCustomerDto { Name = customerName };
            var res = await Api.CreateCustomerAsync(dto, asDealer: true);
            msg = $"Customer created: {res?.Id}";
            customers = await Api.GetCustomersAsync(asDealer: true);
            customerName = "";
        }
        catch (Exception ex) { msg = ex.Message; }
        finally { isProcessingCustomer = false; StateHasChanged(); }
    }

    async Task CreateAccount()
    {
        isProcessingAccount = true;
        accMsg = "";
        try
        {
            var dto = new CreateAccountDto
            {
                Name = accName,
                Email = accEmail,
                TempPassword = accTempPassword,
                Role = accRole,
                CustomerId = selectedCustomerIdForAccount
            };

            var res = await Api.CreateAccountAsync(dto, asDealer: true);
            accMsg = $"Account created: {res?.Id}";
            accounts = await Api.GetAccountsAsync(asDealer: true);

            accName = accEmail = accTempPassword = "";
            accRole = AccountRole.Customer;
            selectedCustomerIdForAccount = null;
        }
        catch (Exception ex) { accMsg = ex.Message; }
        finally { isProcessingAccount = false; StateHasChanged(); }
    }

    async Task AssignUnit()
    {
        try
        {
            if (assignAccountId == null) { assignMsg = "Choose account."; return; }
            var dto = new AssignUnitDto
            {
                MacAddress = assignMac,
                AccountId = assignAccountId.Value,
                UnitName = assignUnitName,
                Location = assignLocation
            };
            var res = await Api.AssignUnitAsync(dto, asDealer: true);
            assignMsg = $"Unit assigned: {res?.MacAddress}";
            assignMac = assignUnitName = assignLocation = "";
        }
        catch (Exception ex) { assignMsg = ex.Message; }
        finally { StateHasChanged(); }
    }
}