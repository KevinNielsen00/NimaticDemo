@page "/dealer"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Frontend.Models
@inject Frontend.Services.ApiService Api
@inject Frontend.Services.AuthService AuthService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<h3>Dealer panel</h3>

@if (loading)
{
    <div class="d-flex align-items-center">
        <div class="spinner-border text-primary me-2" role="status"></div>
        <span>Loading...</span>
    </div>
}
else if (!isAuthorized)
{
    <div class="alert alert-danger">Not authorized. Redirecting...</div>
}
else
{
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Create Customer</div>
                <div class="card-body">
                    <EditForm Model="createCustomerModel" OnValidSubmit="HandleCreateCustomer">
                        <div class="mb-2">
                            <InputText class="form-control" @bind-Value="createCustomerModel.Name" placeholder="Customer name" />
                        </div>
                        <button class="btn btn-primary" disabled="@isProcessingCustomer">
                            @if (isProcessingCustomer)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Creating...</span>
                            }
                            else
                            {
                                <span>Create Customer</span>
                            }
                        </button>
                        @if (!string.IsNullOrWhiteSpace(customerMsg))
                        {
                            <div class="mt-2 text-muted">@customerMsg</div>
                        }
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Create Customer Account</div>
                <div class="card-body">
                    <EditForm Model="createAccountModel" OnValidSubmit="HandleCreateAccount">
                        <div class="mb-2">
                            <label class="form-label">Customer</label>
                            <select class="form-select" @bind="SelectedCustomerIdForAccount">
                                <option value="">-- choose customer --</option>
                                @foreach (var c in customers)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                                }
                            </select>
                        </div>

                        <div class="mb-2">
                            <InputText class="form-control" @bind-Value="createAccountModel.Name" placeholder="Account name" />
                        </div>

                        <div class="mb-2">
                            <InputText class="form-control" @bind-Value="createAccountModel.Email" placeholder="Email" />
                        </div>

                        <div class="mb-2">
                            <InputText class="form-control" @bind-Value="createAccountModel.TempPassword" placeholder="Temp password" />
                        </div>

                        <div class="mt-2">
                            <button class="btn btn-primary" disabled="@isProcessingAccount">
                                @if (isProcessingAccount)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Creating...</span>
                                }
                                else
                                {
                                    <span>Create Account</span>
                                }
                            </button>
                            @if (!string.IsNullOrWhiteSpace(accountMsg))
                            {
                                <div class="mt-2 text-muted">@accountMsg</div>
                            }
                        </div>
                    </EditForm>
                    <div class="form-text mt-2">Dealer can only create Customer accounts for their customers.</div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header">Assign Unit to Customer</div>
                <div class="card-body">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label">Customer Account</label>
                            <select class="form-select" @bind="assignAccountId">
                                <option value="">-- choose customer account --</option>
                                @foreach (var a in accounts)
                                {
                                    <option value="@a.Id">@a.Email (@a.Name)</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">MAC</label>
                            <InputText class="form-control" @bind-Value="assignMac" />
                        </div>

                        <div class="col-md-2">
                            <button class="btn btn-primary w-100" @onclick="AssignUnit" disabled="@isProcessingAssign">
                                @if (isProcessingAssign)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Assigning...</span>
                                }
                                else
                                {
                                    <span>Assign Unit</span>
                                }
                            </button>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(assignMsg))
                    {
                        <div class="mt-2 text-muted">@assignMsg</div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    List<CustomerDto> customers = new();
    List<AccountDto> accounts = new();

    CreateCustomerDto createCustomerModel = new();
    CreateAccountDto createAccountModel = new() { Role = AccountRole.Customer };

    bool loading = true;
    bool isAuthorized = false;
    bool checkedLoginState;
    bool isProcessingCustomer = false;
    bool isProcessingAccount = false;
    bool isProcessingAssign = false;

    string customerMsg = "";
    string accountMsg = "";
    string assignMsg = "";

    Guid? SelectedCustomerIdForAccount
    {
        get => createAccountModel.CustomerId;
        set
        {
            createAccountModel.CustomerId = value;
        }
    }

    Guid? assignAccountId = null;
    string assignMac = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || checkedLoginState) return;
        checkedLoginState = true;

        loading = true;
        StateHasChanged();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (!user.IsInRole("Dealer"))
        {
            Nav.NavigateTo("/dashboard");
            return;
        }

        isAuthorized = true;

        var token = await AuthService.GetTokenAsync();
        Api.SetToken(token);

        try
        {
            customers = await Api.GetCustomersAsync(asDealer: true);
            accounts = await Api.GetAccountsAsync(asDealer: true);
        }
        catch (HttpRequestException ex)
        {
            customerMsg = ex.Message;
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    async Task HandleCreateCustomer()
    {
        isProcessingCustomer = true;
        customerMsg = "";
        try
        {
            var res = await Api.CreateCustomerAsync(createCustomerModel, asDealer: true);
            customerMsg = $"Customer created: {res?.Id}";
            customers = await Api.GetCustomersAsync(asDealer: true);
            createCustomerModel = new();
        }
        catch (HttpRequestException ex) { customerMsg = ex.Message; }
        catch (Exception ex) { customerMsg = ex.Message; }
        finally { isProcessingCustomer = false; StateHasChanged(); }
    }

    async Task HandleCreateAccount()
    {
        isProcessingAccount = true;
        accountMsg = "";
        try
        {
            // enforce Customer role for dealer-created accounts
            createAccountModel.Role = AccountRole.Customer;
            createAccountModel.CustomerId = SelectedCustomerIdForAccount;

            var res = await Api.CreateAccountAsync(createAccountModel, asDealer: true);
            accountMsg = $"Account created: {res?.Id}";
            accounts = await Api.GetAccountsAsync(asDealer: true);
            createAccountModel = new() { Role = AccountRole.Customer };
        }
        catch (HttpRequestException ex) { accountMsg = ex.Message; }
        catch (Exception ex) { accountMsg = ex.Message; }
        finally { isProcessingAccount = false; StateHasChanged(); }
    }

    async Task AssignUnit()
    {
        isProcessingAssign = true;
        assignMsg = "";

        try
        {
            if (assignAccountId == null) { assignMsg = "Choose customer account."; return; }
            if (string.IsNullOrWhiteSpace(assignMac)) { assignMsg = "Provide MAC address."; return; }

            var dto = new AssignUnitDto
            {
                MacAddress = assignMac,
                AccountId = assignAccountId.Value
            };

            var res = await Api.AssignUnitAsync(dto, asDealer: true);
            assignMsg = $"Unit assigned: {res?.MacAddress}";
        }
        catch (HttpRequestException ex) { assignMsg = ex.Message; }
        catch (Exception ex) { assignMsg = ex.Message; }
        finally { isProcessingAssign = false; StateHasChanged(); }
    }
}