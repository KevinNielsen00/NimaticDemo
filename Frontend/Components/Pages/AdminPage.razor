@page "/admin"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Frontend.Models
@inject Frontend.Services.ApiService Api
@inject Frontend.Services.AuthService AuthService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<h3>Admin panel</h3>

@if (loading)
{
    <div class="d-flex align-items-center">
        <div class="spinner-border text-primary me-2" role="status"><span class="visually-hidden">Loading...</span></div>
        <span>Loading...</span>
    </div>
}
else if (!isAuthorized)
{
    <div class="alert alert-danger">Not authorized. Redirecting...</div>
}
else
{
        <!-- Create Account (Admin can create Admin/Dealer/Customer) -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Create Account</div>
                <div class="card-body">
                    <EditForm Model="createAccountModel" OnValidSubmit="HandleCreateAccount">
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label">Role</label>
                                <select class="form-select" @bind="createAccountModel.Role">
                                    <option value="Admin">@AccountRole.Admin</option>
                                    <option value="Dealer">@AccountRole.Dealer</option>
                                    <option value="Customer">@AccountRole.Customer</option>
                                </select>
                            </div>

                            <div class="col-md-8">
                                <label class="form-label">Dealer (optional)</label>
                                <select class="form-select" @bind="SelectedDealerIdForAccount">
                                    <option value="">-- optional dealer --</option>
                                    @foreach (var d in dealers)
                                    {
                                        <option value="@d.Id">@d.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Name</label>
                                <InputText class="form-control" @bind-Value="createAccountModel.Name" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <InputText class="form-control" @bind-Value="createAccountModel.Email" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Temp password</label>
                                <InputText class="form-control" @bind-Value="createAccountModel.TempPassword" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Customer (optional)</label>
                                <select class="form-select" @bind="createAccountModel.CustomerId">
                                    <option value="">-- optional customer --</option>
                                    @foreach (var c in customersForSelectedDealer)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mt-3">
                            <button class="btn btn-primary" disabled="@isProcessingAccount">
                                @if (isProcessingAccount)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Creating...</span>
                                }
                                else
                                {
                                    <span>Create Account</span>
                                }
                            </button>

                            @if (!string.IsNullOrWhiteSpace(accountMsg))
                            {
                                <div class="mt-2 text-muted">@accountMsg</div>
                            }
                        </div>
                    </EditForm>

                    <div class="form-text mt-2">
                        Tip: To create a Dealer account choose role "Dealer". To create a Customer choose "Customer" and pick a Dealer.
                    </div>
                </div>
            </div>
        </div>

        <!-- Assign Unit -->
        <div class="col-12">
            <div class="card">
                <div class="card-header">Assign Unit to Account</div>
                <div class="card-body">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Filter</label>
                            <select class="form-select" @bind="assignAccountFilter">
                                <option value="All">All accounts</option>
                                <option value="Dealers">Dealers</option>
                                <option value="Customers">Customers</option>
                            </select>
                        </div>

                        <div class="col-md-5">
                            <label class="form-label">Account</label>
                            <select class="form-select" @bind="assignAccountId">
                                <option value="">-- choose account --</option>
                                @foreach (var a in FilteredAccounts)
                                {
                                    <option value="@a.Id">@a.Email (@a.Name) - @a.Role</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">MAC</label>
                            <InputText class="form-control" @bind-Value="assignMac" />
                        </div>

                        <div class="col-md-2">
                            <button class="btn btn-primary w-100" @onclick="AssignUnit" disabled="@isProcessingAssign">
                                @if (isProcessingAssign)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Assigning...</span>
                                }
                                else
                                {
                                    <span>Assign Unit</span>
                                }
                            </button>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(assignMsg))
                    {
                        <div class="mt-2 text-muted">@assignMsg</div>
                    }
                </div>
            </div>
        </div>
}

@code {
    bool loading = true;
    bool isAuthorized = false;
    bool checkedLoginState;

    List<DealerDto> dealers = new();
    List<CustomerDto> customersForSelectedDealer = new();
    List<AccountDto> accounts = new();

    // models
    CreateCustomerDto createCustomerModel = new();
    CreateAccountDto createAccountModel = new();

    // flags and messages
    bool isProcessingCustomer = false;
    bool isProcessingAccount = false;
    bool isProcessingAssign = false;

    string customerMsg = "";
    string accountMsg = "";
    string assignMsg = "";

    Guid? SelectedDealerId
    {
        get => selectedDealerId;
        set
        {
            if (selectedDealerId != value)
            {
                selectedDealerId = value;
                _ = LoadCustomersForDealerAsync(selectedDealerId);
            }
        }
    }
    Guid? selectedDealerId;
    Guid? SelectedDealerIdForAccount
    {
        get => selectedDealerIdForAccount;
        set
        {
            if (selectedDealerIdForAccount != value)
            {
                selectedDealerIdForAccount = value;
                _ = LoadCustomersForDealerAsync(selectedDealerIdForAccount);
            }
        }
    }
    Guid? selectedDealerIdForAccount;

    Guid? selectedCustomerIdForAccount;
    Guid? assignAccountId = null;
    string assignMac = "";
    string assignUnitName = "";
    string assignLocation = "";
    string assignAccountFilter = "All";

    IEnumerable<AccountDto> FilteredAccounts =>
        assignAccountFilter switch
        {
            "Dealers" => accounts.Where(a => a.Role == AccountRole.Dealer),
            "Customers" => accounts.Where(a => a.Role == AccountRole.Customer),
            _ => accounts
        };

    protected override void OnInitialized()
    {
        loading = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || checkedLoginState)
            return;

        checkedLoginState = true;

        loading = true;
        StateHasChanged();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (!user.IsInRole("Admin"))
        {
            Nav.NavigateTo("/dashboard");
            return;
        }

        isAuthorized = true;

        Api.SetToken(await AuthService.GetTokenAsync());

        try
        {
            dealers = await Api.GetDealersAsync();
            accounts = await Api.GetAccountsAsync();
        }
        catch (HttpRequestException ex)
        {
            if (ex.Message.Contains("401"))
            {
                await AuthService.LogoutAsync();
                Nav.NavigateTo("/login");
                return;
            }
            customerMsg = ex.Message;
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    async Task LoadCustomersForDealerAsync(Guid? dealerId)
    {
        if (!dealerId.HasValue)
        {
            customersForSelectedDealer = new();
            StateHasChanged();
            return;
        }

        try
        {
            customersForSelectedDealer = await Api.GetCustomersAsync(dealerId);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            customerMsg = ex.Message;
            StateHasChanged();
        }
    }

    async Task HandleCreateCustomer()
    {
        isProcessingCustomer = true;
        customerMsg = "";
        try
        {
            if (SelectedDealerId == null) { customerMsg = "Select dealer first."; return; }
            var dto = new CreateCustomerDto { Name = createCustomerModel.Name, DealerId = SelectedDealerId };
            var res = await Api.CreateCustomerAsync(dto);
            customerMsg = $"Customer created: {res?.Id}";
            customersForSelectedDealer = await Api.GetCustomersAsync(SelectedDealerId);
            createCustomerModel = new();
        }
        catch (Exception ex)
        {
            customerMsg = ex.Message;
        }
        finally
        {
            isProcessingCustomer = false;
        }
    }

    async Task HandleCreateAccount()
    {
        isProcessingAccount = true;
        accountMsg = "";
        try
        {
            createAccountModel.DealerId = SelectedDealerIdForAccount;
            // CustomerId already bound in the form if selected
            var res = await Api.CreateAccountAsync(createAccountModel);
            if (res is null)
            {
                accountMsg = "No response from server.";
            }
            else
            {
                accountMsg = $"Account created: {res.Id} ({res.Email})";
                accounts = await Api.GetAccountsAsync();
                createAccountModel = new CreateAccountDto();
                customersForSelectedDealer = new();
                SelectedDealerIdForAccount = null;
                selectedCustomerIdForAccount = null;
            }
        }
        catch (HttpRequestException ex)
        {
            accountMsg = ex.Message;
        }
        catch (Exception ex)
        {
            accountMsg = ex.Message;
        }
        finally
        {
            isProcessingAccount = false;
        }
    }

    async Task AssignUnit()
    {
        isProcessingAssign = true;
        assignMsg = "";

        try
        {
            if (assignAccountId == null)
            {
                assignMsg = "Choose account.";
                return;
            }

            var mac = (assignMac ?? "").Trim();
            if (string.IsNullOrWhiteSpace(mac))
            {
                assignMsg = "Provide MAC address.";
                return;
            }

            // Simple normalization: remove non-hex characters (optional)
            var normalized = new string(mac.Where(char.IsLetterOrDigit).ToArray());
            if (normalized.Length < 8)
            {
                assignMsg = "MAC looks invalid.";
                return;
            }

            var dto = new AssignUnitDto
            {
                MacAddress = mac, // backend uses case-insensitive compare
                AccountId = assignAccountId.Value,
                UnitName = assignUnitName?.Trim() ?? "",
                Location = assignLocation?.Trim() ?? ""
            };

            // Admin page -> call admin endpoint (ApiService handles URL)
            var res = await Api.AssignUnitAsync(dto);

            if (res != null)
            {
                assignMsg = $"Unit assigned: {res.MacAddress}";
                // Optionally refresh accounts/units
                accounts = await Api.GetAccountsAsync();
            }
            else
            {
                assignMsg = "No response from server.";
            }
        }
        catch (HttpRequestException ex)
        {
            assignMsg = ex.Message;
        }
        catch (Exception ex)
        {
            assignMsg = ex.Message;
        }
        finally
        {
            isProcessingAssign = false;
            StateHasChanged();
        }
    }
}