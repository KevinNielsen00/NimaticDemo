@page "/admin"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Frontend.Models
@inject Frontend.Services.ApiService Api
@inject Frontend.Services.AuthService AuthService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<h3>Admin panel</h3>

@if (loading)
{
    <div class="d-flex align-items-center">
        <div class="spinner-border text-primary me-2" role="status"></div>
        <span>Loading...</span>
    </div>
}
else if (!isAuthorized)
{
    <div class="alert alert-danger">Not authorized. Redirecting...</div>
}
else
{
    <div class="row g-3">
        <!-- Create Account (Admin can create Admin/Dealer/Customer) -->
        <div class="col-12">
            <div class="card">
                <div class="card-header">Create Account</div>
                <div class="card-body">
                    <EditForm Model="createAccountModel" OnValidSubmit="HandleCreateAccount">
                        <div class="row g-2">
                            <div class="col-md-3">
                                <label class="form-label">Role</label>
                                <InputSelect class="form-select" @bind-Value="createAccountModel.Role">
                                    @foreach (AccountRole r in Enum.GetValues(typeof(AccountRole)))
                                    {
                                        <option value="@r">@r.ToString()</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-md-5">
                                <label class="form-label">Assign to Dealer (dealer account) - optional</label>
                                <select class="form-select" @bind="SelectedDealerAccountId">
                                    <option value="">-- optional dealer account --</option>
                                    @foreach (var da in dealerAccounts)
                                    {
                                        <option value="@da.Id">@da.Name (@da.Email)</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Dealer (entity) - read-only</label>
                                <InputText class="form-control" Value="@(createAccountModel.DealerId?.ToString() ?? "")" Disabled="true" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Name</label>
                                <InputText class="form-control" @bind-Value="createAccountModel.Name" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <InputText class="form-control" @bind-Value="createAccountModel.Email" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Temp password</label>
                                <InputText class="form-control" @bind-Value="createAccountModel.TempPassword" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Customer (optional)</label>
                                <select class="form-select" @bind="createAccountModel.CustomerId">
                                    <option value="">-- optional customer --</option>
                                    @foreach (var c in customersForSelectedDealer)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mt-3">
                            <button class="btn btn-primary" disabled="@isProcessingAccount">
                                @if (isProcessingAccount)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Creating...</span>
                                }
                                else
                                {
                                    <span>Create Account</span>
                                }
                            </button>

                            @if (!string.IsNullOrWhiteSpace(accountMsg))
                            {
                                <div class="mt-2 text-muted">@accountMsg</div>
                            }
                        </div>
                    </EditForm>

                    <div class="form-text mt-2">
                        Tip: To create a Dealer account choose role "Dealer". To create a Customer choose "Customer" and pick a Dealer account above.
                    </div>
                </div>
            </div>
        </div>

        <!-- Assign Unit -->
        <div class="col-12">
            <div class="card">
                <div class="card-header">Assign Unit to Account</div>
                <div class="card-body">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Filter</label>
                            <select class="form-select" @bind="assignAccountFilter">
                                <option value="All">All accounts</option>
                                <option value="Dealers">Dealers</option>
                                <option value="Customers">Customers</option>
                            </select>
                        </div>

                        <div class="col-md-5">
                            <label class="form-label">Account</label>
                            <select class="form-select" @bind="assignAccountId">
                                <option value="">-- choose account --</option>
                                @foreach (var a in FilteredAccounts)
                                {
                                    <option value="@a.Id">@a.Email (@a.Name) - @a.Role</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">MAC</label>
                            <InputText class="form-control" @bind-Value="assignMac" />
                        </div>

                        <div class="col-md-2">
                            <button class="btn btn-primary w-100" @onclick="AssignUnit" disabled="@isProcessingAssign">
                                @if (isProcessingAssign)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Assigning...</span>
                                }
                                else
                                {
                                    <span>Assign Unit</span>
                                }
                            </button>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(assignMsg))
                    {
                        <div class="mt-2 text-muted">@assignMsg</div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    bool loading = true;
    bool isAuthorized = false;
    bool checkedLoginState;

    List<DealerDto> dealers = new();
    List<CustomerDto> customersForSelectedDealer = new();
    List<AccountDto> accounts = new();

    List<AccountDto> dealerAccounts = new();

    // create account model
    CreateAccountDto createAccountModel = new();

    // flags and messages
    bool isProcessingAccount = false;
    bool isProcessingAssign = false;

    string accountMsg = "";
    string assignMsg = "";

    Guid? selectedDealerAccountId;
    Guid? assignAccountId = null;
    string assignMac = "";
    string assignUnitName = "";
    string assignLocation = "";
    string assignAccountFilter = "All";

    IEnumerable<AccountDto> FilteredAccounts =>
        assignAccountFilter switch
        {
            "Dealers" => accounts.Where(a => a.Role == AccountRole.Dealer),
            "Customers" => accounts.Where(a => a.Role == AccountRole.Customer),
            _ => accounts
        };

    Guid? SelectedDealerAccountId
    {
        get => selectedDealerAccountId;
        set
        {
            if (selectedDealerAccountId != value)
            {
                selectedDealerAccountId = value;

                if (selectedDealerAccountId.HasValue)
                {
                    var acct = accounts.FirstOrDefault(a => a.Id == selectedDealerAccountId.Value);
                    createAccountModel.DealerId = acct?.DealerId;
                    _ = LoadCustomersForDealerAsync(acct?.DealerId);
                }
                else
                {
                    createAccountModel.DealerId = null;
                    customersForSelectedDealer = new();
                }
            }
        }
    }

    protected override void OnInitialized()
    {
        loading = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || checkedLoginState)
            return;

        checkedLoginState = true;

        loading = true;
        StateHasChanged();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated != true)
        {
            isAuthorized = false;
            loading = false;
            Nav.NavigateTo("/login");
            return;
        }

        // require Admin for this page
        if (!user.IsInRole("Admin") && !user.IsInRole(nameof(AccountRole.Admin)))
        {
            isAuthorized = false;
            loading = false;
            Nav.NavigateTo("/dashboard");
            return;
        }

        isAuthorized = true;

        var token = await AuthService.GetTokenAsync();
        Api.SetToken(token);

        try
        {
            dealers = await Api.GetDealersAsync();
            accounts = await Api.GetAccountsAsync();
            dealerAccounts = accounts.Where(a => a.Role == AccountRole.Dealer).ToList();
        }
        catch (HttpRequestException ex)
        {
            accountMsg = ex.Message;
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    async Task LoadCustomersForDealerAsync(Guid? dealerId)
    {
        if (!dealerId.HasValue)
        {
            customersForSelectedDealer = new();
            StateHasChanged();
            return;
        }

        try
        {
            customersForSelectedDealer = await Api.GetCustomersAsync(dealerId);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            accountMsg = ex.Message;
            StateHasChanged();
        }
    }

    async Task HandleCreateAccount()
    {
        isProcessingAccount = true;
        accountMsg = "";

        try
        {
            // createAccountModel.DealerId already set when selecting dealer-account
            var res = await Api.CreateAccountAsync(createAccountModel);
            if (res is null)
            {
                accountMsg = "No response from server.";
            }
            else
            {
                accountMsg = $"Account created: {res.Id} ({res.Email})";
                accounts = await Api.GetAccountsAsync();
                dealerAccounts = accounts.Where(a => a.Role == AccountRole.Dealer).ToList();
                // reset form
                createAccountModel = new();
                customersForSelectedDealer = new();
                selectedDealerAccountId = null;
            }
        }
        catch (HttpRequestException ex)
        {
            accountMsg = ex.Message;
        }
        catch (Exception ex)
        {
            accountMsg = ex.Message;
        }
        finally
        {
            isProcessingAccount = false;
            StateHasChanged();
        }
    }

    async Task AssignUnit()
    {
        isProcessingAssign = true;
        assignMsg = "";

        try
        {
            if (assignAccountId == null) { assignMsg = "Choose account."; return; }
            var dto = new AssignUnitDto
            {
                MacAddress = assignMac,
                AccountId = assignAccountId.Value,
                UnitName = assignUnitName,
                Location = assignLocation
            };

            var res = await Api.AssignUnitAsync(dto);
            assignMsg = $"Unit assigned: {res?.MacAddress}";
            // refresh accounts/units if needed
            accounts = await Api.GetAccountsAsync();
        }
        catch (HttpRequestException ex)
        {
            assignMsg = ex.Message;
        }
        catch (Exception ex)
        {
            assignMsg = ex.Message;
        }
        finally
        {
            isProcessingAssign = false;
            StateHasChanged();
        }
    }
}