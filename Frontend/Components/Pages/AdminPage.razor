@page "/admin"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Frontend.Models
@inject Frontend.Services.ApiService Api
@inject Frontend.Services.AuthService AuthService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<h3>Admin panel</h3>

@if (loading)
{
    <div class="d-flex align-items-center">
        <div class="spinner-border text-primary me-2" role="status"><span class="visually-hidden">Loading...</span></div>
        <span>Loading...</span>
    </div>
}
else if (!isAuthorized)
{
    <div class="alert alert-danger">Not authorized. Redirecting...</div>
}
else
{
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Create Dealer</div>
                <div class="card-body">
                    <EditForm Model="createDealerModel" OnValidSubmit="HandleCreateDealer">
                        <div class="mb-2">
                            <InputText class="form-control" @bind-Value="createDealerModel.Name" placeholder="Dealer name" />
                        </div>
                        <button class="btn btn-primary" disabled="@isProcessingDealer">
                            @if (isProcessingDealer)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Creating...</span>
                            }
                            else
                            {
                                <span>Create Dealer</span>
                            }
                        </button>
                        @if (!string.IsNullOrWhiteSpace(dealerMsg))
                        {
                            <div class="mt-2 text-muted">@dealerMsg</div>
                        }
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Create Customer (under dealer)</div>
                <div class="card-body">
                    <EditForm Model="createCustomerModel" OnValidSubmit="HandleCreateCustomer">
                        <div class="mb-2">
                            <label class="form-label">Dealer</label>
                            <select class="form-select" @bind="SelectedDealerId">
                                <option value="">-- choose dealer --</option>
                                @foreach (var d in dealers)
                                {
                                    <option value="@d.Id">@d.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <InputText class="form-control" @bind-Value="createCustomerModel.Name" placeholder="Customer name" />
                        </div>
                        <button class="btn btn-primary" disabled="@isProcessingCustomer">
                            @if (isProcessingCustomer)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Creating...</span>
                            }
                            else
                            {
                                <span>Create Customer</span>
                            }
                        </button>
                        @if (!string.IsNullOrWhiteSpace(customerMsg))
                        {
                            <div class="mt-2 text-muted">@customerMsg</div>
                        }
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header">Create Account (Admin)</div>
                <div class="card-body">
                    <EditForm Model="createAccountModel" OnValidSubmit="HandleCreateAccount">
                        <div class="row g-2">
                            <div class="col-md-3">
                                <label class="form-label">Dealer (optional)</label>
                                <select class="form-select" @bind="SelectedDealerIdForAccount">
                                    <option value="">-- optional dealer --</option>
                                    @foreach (var d in dealers)
                                    {
                                        <option value="@d.Id">@d.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Customer (optional)</label>
                                <select class="form-select" @bind="selectedCustomerIdForAccount">
                                    <option value="">-- optional customer --</option>
                                    @foreach (var c in customersForSelectedDealer)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Name</label>
                                <InputText class="form-control" @bind-Value="createAccountModel.Name" />
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Email</label>
                                <InputText class="form-control" @bind-Value="createAccountModel.Email" />
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Temp password</label>
                                <InputText class="form-control" @bind-Value="createAccountModel.TempPassword" />
                            </div>
                        </div>

                        <div class="mt-2">
                            <label class="form-label">Role</label>
                            <InputText class="form-control" @bind-Value="createAccountModel.Role" placeholder="Admin/Dealer/Customer" />
                        </div>

                        <div class="mt-3">
                            <button class="btn btn-primary" disabled="@isProcessingAccount">
                                @if (isProcessingAccount)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Creating...</span>
                                }
                                else
                                {
                                    <span>Create Account</span>
                                }
                            </button>
                            @if (!string.IsNullOrWhiteSpace(accountMsg))
                            {
                                <div class="mt-2 text-muted">@accountMsg</div>
                            }
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header">Assign Unit to Account</div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label">Account</label>
                            <select class="form-select" @bind="assignAccountId">
                                <option value="">-- choose account --</option>
                                @foreach (var a in accounts)
                                {
                                    <option value="@a.Id">@a.Email (@a.Name)</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">MAC</label>
                            <InputText class="form-control" @bind-Value="assignMac" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Unit name</label>
                            <InputText class="form-control" @bind-Value="assignUnitName" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Location</label>
                            <InputText class="form-control" @bind-Value="assignLocation" />
                        </div>
                    </div>

                    <div class="mt-3">
                        <button class="btn btn-primary" @onclick="AssignUnit" disabled="@isProcessingAssign">
                            @if (isProcessingAssign)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Assigning...</span>
                            }
                            else
                            {
                                <span>Assign Unit</span>
                            }
                        </button>
                        @if (!string.IsNullOrWhiteSpace(assignMsg))
                        {
                            <div class="mt-2 text-muted">@assignMsg</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    bool loading = true;
    bool isAuthorized = true;
    bool checkedLoginState;

    List<DealerDto> dealers = new();
    List<CustomerDto> customersForSelectedDealer = new();
    List<AccountDto> accounts = new();

    // form models
    CreateDealerDto createDealerModel = new();
    CreateCustomerDto createCustomerModel = new();
    CreateAccountDto createAccountModel = new();

    // messages & flags
    string dealerMsg = "";
    string customerMsg = "";
    string accountMsg = "";
    string assignMsg = "";

    bool isProcessingDealer = false;
    bool isProcessingCustomer = false;
    bool isProcessingAccount = false;
    bool isProcessingAssign = false;

    Guid? selectedDealerId;
    Guid? selectedDealerIdForAccount;
    Guid? selectedCustomerIdForAccount;

    Guid? assignAccountId = null;
    string assignMac = "";
    string assignUnitName = "";
    string assignLocation = "";

    Guid? SelectedDealerId
    {
        get => selectedDealerId;
        set
        {
            if (selectedDealerId != value)
            {
                selectedDealerId = value;
                _ = LoadCustomersForDealerAsync(selectedDealerId);
            }
        }
    }

    Guid? SelectedDealerIdForAccount
    {
        get => selectedDealerIdForAccount;
        set
        {
            if (selectedDealerIdForAccount != value)
            {
                selectedDealerIdForAccount = value;
                _ = LoadCustomersForDealerAsync(selectedDealerIdForAccount);
            }
        }
    }

    protected override void OnInitialized()
    {
        loading = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || checkedLoginState)
            return;

        checkedLoginState = true;

        loading = true;
        StateHasChanged();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (!user.IsInRole("Admin"))
        {
            Nav.NavigateTo("/dashboard");
            return;
        }

        Api.SetToken(await AuthService.GetTokenAsync());

        try
        {
            dealers = await Api.GetDealersAsync();
            accounts = await Api.GetAccountsAsync();
        }
        catch (HttpRequestException ex)
        {
            if (ex.Message.Contains("401"))
            {
                await AuthService.LogoutAsync();
                Nav.NavigateTo("/login");
                return;
            }
            dealerMsg = ex.Message;
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    async Task LoadCustomersForDealerAsync(Guid? dealerId)
    {
        if (!dealerId.HasValue)
        {
            customersForSelectedDealer = new();
            StateHasChanged();
            return;
        }

        try
        {
            customersForSelectedDealer = await Api.GetCustomersAsync(dealerId);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            customerMsg = ex.Message;
            StateHasChanged();
        }
    }

    async Task HandleCreateDealer()
    {
        isProcessingDealer = true;
        dealerMsg = "";
        try
        {
            var res = await Api.CreateDealerAsync(createDealerModel);
            dealerMsg = $"Dealer created: {res?.Id}";
            dealers = await Api.GetDealersAsync();
            createDealerModel = new();
        }
        catch (Exception ex) { dealerMsg = ex.Message; }
        finally { isProcessingDealer = false; }
    }

    async Task HandleCreateCustomer()
    {
        isProcessingCustomer = true;
        customerMsg = "";
        try
        {
            if (SelectedDealerId == null) { customerMsg = "Select dealer first."; return; }
            createCustomerModel.DealerId = SelectedDealerId;
            var res = await Api.CreateCustomerAsync(createCustomerModel);
            customerMsg = $"Customer created: {res?.Id}";
            customersForSelectedDealer = await Api.GetCustomersAsync(SelectedDealerId);
            createCustomerModel = new();
        }
        catch (Exception ex) { customerMsg = ex.Message; }
        finally { isProcessingCustomer = false; }
    }

    async Task HandleCreateAccount()
    {
        isProcessingAccount = true;
        accountMsg = "";
        try
        {
            createAccountModel.DealerId = SelectedDealerIdForAccount;
            createAccountModel.CustomerId = selectedCustomerIdForAccount;
            var res = await Api.CreateAccountAsync(createAccountModel);
            accountMsg = $"Account created: {res?.Id}";
            accounts = await Api.GetAccountsAsync();
            createAccountModel = new();
        }
        catch (Exception ex) { accountMsg = ex.Message; }
        finally { isProcessingAccount = false; }
    }

    async Task AssignUnit()
    {
        isProcessingAssign = true;
        assignMsg = "";
        try
        {
            if (assignAccountId == null) { assignMsg = "Choose account."; return; }
            var dto = new AssignUnitDto
            {
                MacAddress = assignMac,
                AccountId = assignAccountId.Value,
                UnitName = assignUnitName,
                Location = assignLocation
            };
            var res = await Api.AssignUnitAsync(dto);
            assignMsg = $"Unit assigned: {res?.MacAddress}";
            assignMac = assignUnitName = assignLocation = "";
        }
        catch (Exception ex) { assignMsg = ex.Message; }
        finally { isProcessingAssign = false; }
    }
}