@page "/admin"
@inject Frontend.Services.ApiService Api

<h3>Admin panel</h3>

<section>
    <h4>Create Dealer</h4>
    <input @bind="dealerName" placeholder="Dealer name" />
    <button @onclick="CreateDealer">Create Dealer</button>
    <div>@dealerMsg</div>
</section>

<section>
    <h4>Create Customer (under dealer)</h4>
    <select @bind="SelectedDealerId">
        <option value="">-- choose dealer --</option>
        @foreach (var d in dealers)
        {
            <option value="@d.Id">@d.Name</option>
        }
    </select>
    <input @bind="customerName" placeholder="Customer name" />
    <button @onclick="CreateCustomer">Create Customer</button>
    <div>@customerMsg</div>
</section>

<section>
    <h4>Create Account (Admin)</h4>
    <select @bind="SelectedDealerIdForAccount">
        <option value="">-- optional dealer --</option>
        @foreach (var d in dealers)
        {
            <option value="@d.Id">@d.Name</option>
        }
    </select>

    <select @bind="selectedCustomerIdForAccount">
        <option value="">-- optional customer --</option>
        @foreach (var c in customersForSelectedDealer)
        {
            <option value="@c.Id">@c.Name</option>
        }
    </select>

    <input @bind="accName" placeholder="Name" />
    <input @bind="accEmail" placeholder="Email" />
    <input @bind="accTempPassword" placeholder="Temp password" />
    <input @bind="accRole" placeholder="Role (Admin/Dealer/Customer)" />
    <button @onclick="CreateAccount">Create Account</button>
    <div>@accountMsg</div>
</section>

<section>
    <h4>Assign Unit to Account</h4>
    <select @bind="assignAccountId">
        <option value="">-- choose account --</option>
        @foreach (var a in accounts)
        {
            <option value="@a.Id">@a.Email (@a.Name)</option>
        }
    </select>
    <input @bind="assignMac" placeholder="MAC address" />
    <input @bind="assignUnitName" placeholder="Unit name" />
    <input @bind="assignLocation" placeholder="Location" />
    <button @onclick="AssignUnit">Assign Unit</button>
    <div>@assignMsg</div>
</section>

@code {
    List<Frontend.Models.DealerDto> dealers = new();
    List<Frontend.Models.CustomerDto> customersForSelectedDealer = new();
    List<Frontend.Models.AccountDto> accounts = new();

    string dealerName = "";
    string dealerMsg = "";

    string customerName = "";
    Guid? selectedDealerId;
    string customerMsg = "";

    string accName = "";
    string accEmail = "";
    string accTempPassword = "";
    string accRole = "Customer";
    Guid? selectedDealerIdForAccount;
    Guid? selectedCustomerIdForAccount;
    string accountMsg = "";

    Guid? assignAccountId = null;
    string assignMac = "";
    string assignUnitName = "";
    string assignLocation = "";
    string assignMsg = "";

    Guid? SelectedDealerId
    {
        get => selectedDealerId;
        set
        {
            if (selectedDealerId != value)
            {
                selectedDealerId = value;
                _ = OnSelectedDealerChangedAsync(value);
            }
        }
    }

    Guid? SelectedDealerIdForAccount
    {
        get => selectedDealerIdForAccount;
        set
        {
            if (selectedDealerIdForAccount != value)
            {
                selectedDealerIdForAccount = value;
                _ = OnSelectedDealerForAccountChangedAsync(value);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        dealers = await Api.GetDealersAsync();
        accounts = await Api.GetAccountsAsync();
    }

    async Task OnSelectedDealerChangedAsync(Guid? dealerId)
    {
        if (dealerId.HasValue)
            customersForSelectedDealer = await Api.GetCustomersAsync(dealerId);
        else
            customersForSelectedDealer = new();
        StateHasChanged();
    }

    async Task OnSelectedDealerForAccountChangedAsync(Guid? dealerId)
    {
        if (dealerId.HasValue)
            customersForSelectedDealer = await Api.GetCustomersAsync(dealerId);
        else
            customersForSelectedDealer = new();
        StateHasChanged();
    }

    async Task CreateDealer()
    {
        try
        {
            var dto = new Frontend.Models.CreateDealerDto { Name = dealerName };
            var res = await Api.CreateDealerAsync(dto);
            dealerMsg = $"Dealer created: {res?.Id}";
            dealers = await Api.GetDealersAsync();
        }
        catch (Exception ex) { dealerMsg = ex.Message; }
    }

    async Task CreateCustomer()
    {
        try
        {
            if (SelectedDealerId == null) { customerMsg = "Select dealer first."; return; }
            var dto = new Frontend.Models.CreateCustomerDto { Name = customerName, DealerId = SelectedDealerId };
            var res = await Api.CreateCustomerAsync(dto);
            customerMsg = $"Customer created: {res?.Id}";
            customersForSelectedDealer = await Api.GetCustomersAsync(SelectedDealerId);
        }
        catch (Exception ex) { customerMsg = ex.Message; }
    }

    async Task CreateAccount()
    {
        try
        {
            var dto = new Frontend.Models.CreateAccountDto
            {
                Name = accName,
                Email = accEmail,
                TempPassword = accTempPassword,
                Role = accRole,
                DealerId = SelectedDealerIdForAccount,
                CustomerId = selectedCustomerIdForAccount
            };
            var res = await Api.CreateAccountAsync(dto);
            accountMsg = $"Account created: {res?.Id}";
            accounts = await Api.GetAccountsAsync();
        }
        catch (Exception ex) { accountMsg = ex.Message; }
    }

    async Task AssignUnit()
    {
        try
        {
            if (assignAccountId == null) { assignMsg = "Choose account."; return; }
            var dto = new Frontend.Models.AssignUnitDto
            {
                MacAddress = assignMac,
                AccountId = assignAccountId.Value,
                UnitName = assignUnitName,
                Location = assignLocation
            };
            var res = await Api.AssignUnitAsync(dto);
            assignMsg = $"Unit assigned: {res?.MacAddress}";
        }
        catch (Exception ex) { assignMsg = ex.Message; }
    }
}