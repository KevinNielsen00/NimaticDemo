@page "/login"
@using Microsoft.AspNetCore.Components.Authorization
@using Frontend.Services
@inject Frontend.Services.AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<h3>Login</h3>

<input @bind="email" placeholder="Email" />
<input @bind="password" placeholder="Password" type="password" />
<button @onclick="DoLogin">Login</button>
<div>@message</div>

@code {
    string email = "";
    string password = "";
    string message = "";

    async Task DoLogin()
    {
        try
        {
            var res = await AuthService.LoginAsync(new Frontend.Models.LoginRequestDto { Email = email, Password = password });
            var token = await AuthService.GetTokenAsync();
            if (!string.IsNullOrWhiteSpace(token))
            {
                // set API header
                // assume ApiService is accessible via AuthService or inject ApiService here
                // await AuthService._apiService.SetToken(token); // (example—use your ApiService)
            }

            // notify JwtAuthStateProvider to refresh authentication state
            if (AuthStateProvider is JwtAuthStateProvider jwt)
            {
                await jwt.NotifyAuthenticationStateFromLocalStorageAsync();
            }

            Navigation.NavigateTo("/", forceLoad: false);
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }
}