@page "/change-password"
@inject Frontend.Services.AuthService AuthService
@inject NavigationManager Nav

<h3>Skift password</h3>

<input @bind="CurrentPassword" placeholder="Nuværende password" type="password" />
<input @bind="NewPassword" placeholder="Nyt password" type="password" />
<button @onclick="Change">Skift</button>

@code {
    string? CurrentPassword;
    string NewPassword = "";

    async Task Change()
    {
        var dto = new Frontend.Models.ChangePasswordDto
        {
            CurrentPassword = CurrentPassword,
            NewPassword = NewPassword
        };

        await AuthService.ChangePasswordAsync(dto);
        // efter succes - redirect til homepage eller login
        Nav.NavigateTo("/");
    }
}