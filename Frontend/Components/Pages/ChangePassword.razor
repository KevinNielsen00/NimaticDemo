@page "/change-password"
@inject Frontend.Services.AuthService AuthService
@inject NavigationManager Nav

<h3>Skift password</h3>

<div>
    <label>Nuværende password</label>
    <input @bind="CurrentPassword" type="password" />
</div>
<div>
    <label>Nyt password</label>
    <input @bind="NewPassword" type="password" />
</div>
<button @onclick="Change">Skift</button>
<div>@msg</div>

@code {
    string? CurrentPassword;
    string NewPassword = "";
    string msg = "";

    async Task Change()
    {
        try
        {
            var dto = new Frontend.Models.ChangePasswordDto
            {
                CurrentPassword = CurrentPassword,
                NewPassword = NewPassword
            };

            await AuthService.ChangePasswordAsync(dto);
            msg = "Password ændret. Logger ind igen...";
            // Optionelt: log brugeren ud eller redirect
            await AuthService.LogoutAsync();
            Nav.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            msg = ex.Message;
        }
    }
}